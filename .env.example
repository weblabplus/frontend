# Frontend (Next.js) — αντιγράψτε το σε .env.local

# URL του backend API
# Τοπικά: http://localhost:3001/api
# Production (Vercel): https://medilab-api.onrender.com/api
# Στο Vercel αν λείπει ή δείχνει σε localhost, το next.config.js χρησιμοποιεί
# αυτόματα το deployed backend (με warning στο build log) — το deployment δεν σπάει.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# GNews API — server-side, διαβάζεται από το /api/news (δεν εκτίθεται στον browser).
# Στο Vercel πρέπει επίσης να οριστεί ως Environment Variable, αλλιώς η ενότητα
# «Ιατρικά Νέα» δεν εμφανίζεται (το /api/news επιστρέφει enabled:false).
GNEWS_API_KEY=your-gnews-api-key

# Σύνδεσμος προς το ανεξάρτητο booking app (Hapio Booking Flow) — κουμπί
# «Ραντεβού ασθενή» στο NavBar + ενότητα Hapio στις Ρυθμίσεις.
# π.χ. https://medilab-booking.vercel.app
NEXT_PUBLIC_BOOKING_URL=
